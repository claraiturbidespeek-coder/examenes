# Copia este archivo a .env.local y rellena los valores.
# Los encuentras en el dashboard de Supabase → Project Settings → API.

# URL del proyecto, ej. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública. Llega al navegador — es seguro, la tabla exam_pages no tiene
# ninguna política RLS para el rol anon, así que con esta clave no se puede leer.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave privada: SALTA RLS. Solo se usa desde el servidor, en la página del
# alumno. Nunca con prefijo NEXT_PUBLIC_ y nunca commiteada.
SUPABASE_SERVICE_ROLE_KEY=
